# ----------------------------------------------------------------------------
# MyTracker environment variables
# Copy this file to `.env` and fill in real values.
# ----------------------------------------------------------------------------

# Database — Postgres connection string (Neon, Vercel Postgres, Supabase, ...)
# Neon example: postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Public app URL — used to build absolute links inside emails/notifications
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Unsplash (optional) — improves board cover image selection
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=""

# ---- File uploads: Cloudinary (https://cloudinary.com) ----
# Found on the Cloudinary dashboard. Files attached to cards are stored here.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Email reminders: Resend (https://resend.com) ----
# API key from the Resend dashboard.
RESEND_API_KEY=""
# Verified sender. For quick testing you can use Resend's sandbox sender:
#   EMAIL_FROM="MyTracker <onboarding@resend.dev>"
EMAIL_FROM="MyTracker <onboarding@resend.dev>"

# ---- Deadline cron security ----
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to the cron endpoint.
# Generate a random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=""
